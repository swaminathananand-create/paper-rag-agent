# Gemini API Key (Required for live LLM extraction and vector embeddings)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY="AQ.Ab8RN6JTBg_2V5SwMmW-xx6v3c0em_npDlnT9ASG4IK_uVfq2A"
# Alternative environment variable name:
# GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
# Recommended: gemini-3.8-flash (or gemini-flash-latest)
GEMINI_MODEL=gemini-3.8-flash

# Embedding Model Configuration
# Recommended: gemini-embedding-001 or text-embedding-004
EMBEDDING_MODEL=gemini-embedding-001

# Document Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval Settings
TOP_K=5
